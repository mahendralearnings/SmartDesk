# ============================================================================
# SmartDesk Environment Variables
# Copy this to .env and fill in your values: cp .env.example .env
# ============================================================================

# App
APP_NAME=SmartDesk
ENVIRONMENT=dev                          # dev | staging | prod
LOG_LEVEL=INFO

# Database (Phase 8+)
POSTGRES_PASSWORD=localdev
DATABASE_URL=postgresql://smartdesk:localdev@localhost:5432/smartdesk

# Redis (Phase 8+)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Phase 7+)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Preprocessing
PREPROC_REMOVE_URLS=true
PREPROC_REMOVE_EMAILS=true
PREPROC_REMOVE_EMOJIS=false
PREPROC_LOWERCASE=true
PREPROC_LEMMATIZE=true

# Observability (Phase 7+)
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
